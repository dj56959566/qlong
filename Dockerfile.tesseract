FROM python:3.11-slim

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    tesseract-ocr-eng \
    libjpeg-dev \
    zlib1g-dev \
    libfreetype6-dev \
    libtiff5-dev \
    libwebp-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# 更新 pip
RUN pip3 install --upgrade pip

# 安装 Python OCR 依赖
RUN pip3 install --no-cache-dir \
    Pillow \
    requests \
    beautifulsoup4 \
    imap-tools \
    pytesseract
